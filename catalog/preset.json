{
  "version": 2,
  "updatedAt": "2026-10-02",
  "templates": [
    {
      "id": "mysql-8.0",
      "displayName": "MySQL 8.0",
      "category": "数据库",
      "defaultImage": "docker.io/library/mysql",
      "recommendedTags": ["8.0.42", "8.0.40", "8.0.36"],
      "supportedArches": ["amd64", "arm64"],
      "ports": [{ "name": "mysql", "container": 3306, "defaultHost": 3306, "protocol": "tcp" }],
      "envHints": [
        { "key": "MYSQL_ROOT_PASSWORD", "label": "root 密码", "secret": true, "required": true },
        { "key": "MYSQL_DATABASE", "label": "初始数据库" },
        { "key": "MYSQL_USER", "label": "业务账号" },
        { "key": "MYSQL_PASSWORD", "label": "业务账号密码", "secret": true }
      ],
      "dataVolume": "/var/lib/mysql",
      "healthCheck": {"type": "exec", "cmd": ["sh", "-c", "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" mysql -uroot -h127.0.0.1 -e \"SELECT 1\" >/dev/null"]},
      "minMemoryGb": 1
    },
    {
      "id": "redis-7",
      "displayName": "Redis 7",
      "category": "缓存",
      "defaultImage": "docker.io/library/redis",
      "recommendedTags": ["7.2.5", "7.2.4", "7.4.2"],
      "supportedArches": ["amd64", "arm64"],
      "ports": [{ "name": "redis", "container": 6379, "defaultHost": 6379, "protocol": "tcp" }],
      "envHints": [
        { "key": "REDIS_PASSWORD", "label": "访问密码（requirepass，留空则无密码）", "secret": true }
      ],
      "dataVolume": "/data",
      "command": ["sh", "-c", "redis-server --requirepass \"$$REDIS_PASSWORD\""],
      "healthCheck": {"type": "exec", "cmd": ["sh", "-c", "if [ -n \"$REDIS_PASSWORD\" ]; then export REDISCLI_AUTH=\"$REDIS_PASSWORD\"; fi; [ \"$(redis-cli --raw ping)\" = PONG ]"]},
      "minMemoryGb": 0.5
    },
    {
      "id": "postgresql-16",
      "displayName": "PostgreSQL 16",
      "category": "数据库",
      "defaultImage": "docker.io/library/postgres",
      "recommendedTags": ["16.4", "16.3", "16.2"],
      "supportedArches": ["amd64", "arm64"],
      "ports": [{ "name": "pgsql", "container": 5432, "defaultHost": 5432, "protocol": "tcp" }],
      "envHints": [
        { "key": "POSTGRES_PASSWORD", "label": "超级用户密码", "secret": true, "required": true },
        { "key": "POSTGRES_DB", "label": "初始数据库" },
        { "key": "POSTGRES_USER", "label": "超级用户名" }
      ],
      "dataVolume": "/var/lib/postgresql/data",
      "healthCheck": {"type": "exec", "cmd": ["sh", "-c", "PGPASSWORD=\"$POSTGRES_PASSWORD\" psql -h127.0.0.1 -U \"${POSTGRES_USER:-postgres}\" -d \"${POSTGRES_DB:-${POSTGRES_USER:-postgres}}\" -tAc \"SELECT 1\" | grep -qx 1"]},
      "minMemoryGb": 1
    },
    {
      "id": "mongodb-7",
      "displayName": "MongoDB 7",
      "category": "数据库",
      "defaultImage": "docker.io/library/mongo",
      "recommendedTags": ["7.0.14", "7.0.12", "6.0.15"],
      "supportedArches": ["amd64", "arm64"],
      "ports": [{ "name": "mongo", "container": 27017, "defaultHost": 27017, "protocol": "tcp" }],
      "envHints": [
        { "key": "MONGO_INITDB_ROOT_USERNAME", "label": "root 账号", "required": true, "default": "root" },
        { "key": "MONGO_INITDB_ROOT_PASSWORD", "label": "root 密码", "secret": true, "required": true }
      ],
      "dataVolume": "/data/db",
      "healthCheck": {"type": "exec", "cmd": ["sh", "-c", "mongosh --quiet --username \"$MONGO_INITDB_ROOT_USERNAME\" --password \"$MONGO_INITDB_ROOT_PASSWORD\" --authenticationDatabase admin --eval \"if (db.adminCommand({ping:1}).ok!==1) quit(1)\""]},
      "minMemoryGb": 1
    },
    {
      "id": "nginx-1.27",
      "displayName": "Nginx",
      "category": "网关/入口",
      "defaultImage": "docker.io/library/nginx",
      "recommendedTags": ["1.27.2", "1.25.3", "1.24.0"],
      "supportedArches": ["amd64", "arm64"],
      "ports": [
        { "name": "http", "container": 80, "defaultHost": 80, "protocol": "tcp" }
      ],
      "envHints": [],
      "dataVolume": "/usr/share/nginx/html",
      "healthCheck": {"type": "exec", "cmd": ["sh", "-c", "curl -fsS -o /dev/null http://127.0.0.1/ || wget -q -O /dev/null http://127.0.0.1/"]},
      "minMemoryGb": 0.25,
      "remark": "默认提供 HTTP 80，自动初始化空首页；TLS 需显式增加证书和配置，不能仅发布 443。静态文件位于 stack/data/<实例名>。"
    },
    {
      "id": "minio",
      "displayName": "MinIO 对象存储",
      "category": "对象存储",
      "defaultImage": "docker.io/minio/minio",
      "recommendedTags": ["RELEASE.2025-04-22T22-12-26Z"],
      "supportedArches": ["amd64", "arm64"],
      "ports": [
        { "name": "api", "container": 9000, "defaultHost": 9000, "protocol": "tcp" },
        { "name": "console", "container": 9001, "defaultHost": 9001, "protocol": "tcp" }
      ],
      "envHints": [
        { "key": "MINIO_ROOT_USER", "label": "管理员账号", "required": true },
        { "key": "MINIO_ROOT_PASSWORD", "label": "管理员密码", "secret": true, "required": true }
      ],
      "dataVolume": "/data",
      "command": ["server", "/data", "--console-address", ":9001"],
      "healthCheck": { "type": "exec", "cmd": ["curl", "-sf", "http://127.0.0.1:9000/minio/health/live"] },
      "minMemoryGb": 1
    },
    {
      "id": "rabbitmq-3.13",
      "displayName": "RabbitMQ 3.13",
      "category": "消息队列",
      "defaultImage": "docker.io/library/rabbitmq",
      "recommendedTags": ["3.13.7-management", "3.12.14-management"],
      "supportedArches": ["amd64", "arm64"],
      "ports": [
        { "name": "amqp", "container": 5672, "defaultHost": 5672, "protocol": "tcp" },
        { "name": "mgmt", "container": 15672, "defaultHost": 15672, "protocol": "tcp" }
      ],
      "envHints": [
        { "key": "RABBITMQ_DEFAULT_USER", "label": "默认账号", "required": true, "default": "app" },
        { "key": "RABBITMQ_DEFAULT_PASS", "label": "默认密码", "secret": true, "required": true }
      ],
      "dataVolume": "/var/lib/rabbitmq",
      "healthCheck": { "type": "exec", "cmd": ["rabbitmq-diagnostics", "-q", "ping"] },
      "minMemoryGb": 1
    },
    {
      "id": "kafka-3.7",
      "displayName": "Apache Kafka 3.7 (KRaft)",
      "category": "消息队列",
      "defaultImage": "docker.io/apache/kafka",
      "recommendedTags": [
        "3.7.2",
        "3.7.1"
      ],
      "supportedArches": [
        "amd64",
        "arm64"
      ],
      "ports": [
        {
          "name": "kafka",
          "container": 9092,
          "defaultHost": 9092,
          "protocol": "tcp"
        }
      ],
      "envHints": [
        {
          "key": "KAFKA_NODE_ID",
          "label": "KAFKA_NODE_ID",
          "default": "1"
        },
        {
          "key": "KAFKA_PROCESS_ROLES",
          "label": "KAFKA_PROCESS_ROLES",
          "default": "broker,controller"
        },
        {
          "key": "KAFKA_LISTENERS",
          "label": "KAFKA_LISTENERS",
          "default": "PLAINTEXT://:9092,CONTROLLER://:9093"
        },
        {
          "key": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP",
          "label": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP",
          "default": "PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT"
        },
        {
          "key": "KAFKA_CONTROLLER_LISTENER_NAMES",
          "label": "KAFKA_CONTROLLER_LISTENER_NAMES",
          "default": "CONTROLLER"
        },
        {
          "key": "KAFKA_INTER_BROKER_LISTENER_NAME",
          "label": "KAFKA_INTER_BROKER_LISTENER_NAME",
          "default": "PLAINTEXT"
        },
        {
          "key": "KAFKA_CONTROLLER_QUORUM_VOTERS",
          "label": "KAFKA_CONTROLLER_QUORUM_VOTERS",
          "default": "1@localhost:9093"
        },
        {
          "key": "KAFKA_LOG_DIRS",
          "label": "KAFKA_LOG_DIRS",
          "default": "/var/lib/kafka/data"
        },
        {
          "key": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR",
          "label": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR",
          "default": "1"
        },
        {
          "key": "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR",
          "label": "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR",
          "default": "1"
        },
        {
          "key": "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR",
          "label": "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR",
          "default": "1"
        },
        {
          "key": "CLUSTER_ID",
          "label": "CLUSTER_ID",
          "default": "MkU3OEVBNTcwNTJENDM2Qk"
        },
        {
          "key": "KAFKA_ADVERTISED_LISTENERS",
          "label": "对外地址 PLAINTEXT://<本机IP>:<宿主端口>",
          "required": true
        }
      ],
      "dataVolume": "/var/lib/kafka/data",
      "dataUser": "1000:1000",
      "healthCheck": {
        "type": "exec",
        "cmd": [
          "sh",
          "-c",
          "/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list >/dev/null"
        ]
      },
      "healthTimeoutSec": 120,
      "minMemoryGb": 2,
      "remark": "默认采用 Apache 官方镜像。旧 Bitnami 方案需重新选择镜像/参数；数据迁移必须单独验收，不能直接替换原数据目录。advertised 地址必须为客户端可访问的本机 IP/宿主端口。"
    },
    {
      "id": "elasticsearch-8",
      "displayName": "Elasticsearch 8",
      "category": "搜索/观测",
      "defaultImage": "docker.io/library/elasticsearch",
      "recommendedTags": ["8.14.3", "8.13.4", "8.11.4"],
      "supportedArches": ["amd64", "arm64"],
      "ports": [
        { "name": "http", "container": 9200, "defaultHost": 9200, "protocol": "tcp" },
        { "name": "transport", "container": 9300, "defaultHost": 9300, "protocol": "tcp" }
      ],
      "envHints": [
        { "key": "discovery.type", "label": "发现模式", "default": "single-node" },
        { "key": "xpack.security.enabled", "label": "关闭安全认证（内网单机默认）", "default": "false" },
        { "key": "xpack.security.transport.ssl.enabled", "label": "关闭传输层 TLS（内网单机默认）", "default": "false" },
        { "key": "ES_JAVA_OPTS", "label": "JVM 参数", "default": "-Xms2g -Xmx2g" }
      ],
      "dataVolume": "/usr/share/elasticsearch/data",
      "dataUser": "1000:1000",
      "healthCheck": {"type": "exec", "cmd": ["sh", "-c", "curl -fsS \"http://127.0.0.1:9200/_cluster/health?wait_for_status=yellow&timeout=3s\" | grep -Eq '\"timed_out\"[[:space:]]*:[[:space:]]*false'"]},
      "healthTimeoutSec": 180,
      "minMemoryGb": 4,
      "kernelReqs": ["vm.max_map_count>=262144"],
      "remark": "内网单机默认关闭安全认证与 TLS；如需开启请同时调整健康检查与访问凭据"
    },
    {
      "id": "nacos-2",
      "displayName": "Nacos 2 (standalone)",
      "category": "注册/配置中心",
      "defaultImage": "docker.io/nacos/nacos-server",
      "recommendedTags": ["v2.4.3", "v2.3.2"],
      "supportedArches": ["amd64", "arm64"],
      "ports": [
        { "name": "http", "container": 8848, "defaultHost": 8848, "protocol": "tcp" },
        { "name": "grpc", "container": 9848, "defaultHost": 9848, "protocol": "tcp" }
      ],
      "envHints": [
        { "key": "MODE", "label": "运行模式", "default": "standalone" },
        { "key": "NACOS_AUTH_ENABLE", "label": "开启鉴权", "default": "false" }
      ],
      "dataVolume": "/home/nacos/data",
      "healthCheck": { "type": "exec", "cmd": ["curl", "-sf", "http://127.0.0.1:8848/nacos/v1/console/health/readiness"] },
      "minMemoryGb": 2
    }
  ]
}
