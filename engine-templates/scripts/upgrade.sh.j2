#!/usr/bin/env bash
set -euo pipefail
PKG_DIR="$(cd "$(dirname "$0")/.." && pwd)"
BASE_DIR="$PKG_DIR"
source "$PKG_DIR/scripts/runtime.sh"
root_required
TARGET=''; DRY=0
while [ "$#" -gt 0 ]; do
  case "$1" in --target) [ "$#" -ge 2 ] || die '--target 缺少路径'; TARGET=$2; shift 2;; --dry-run) DRY=1; shift;; *) die '用法: upgrade.sh --target 已部署目录 [--dry-run]';; esac
done
[ -n "$TARGET" ] && [ -d "$TARGET" ] || die '必须指定已部署目录'
TARGET=$(cd "$TARGET" && pwd)
[ "$TARGET" != "$PKG_DIR" ] || die '升级包目录不能作为部署目标'
verify_package
check_identity "$TARGET"
BASELINE={{ baseline_build_id | shq }}
[ "$(identity_value "$TARGET" BUILD_ID)" = "$BASELINE" ] || die '目标已部署版本与基线不一致'
# Candidate validation uses target's relative data paths and performs no mutation in dry run.
docker compose --project-directory "$TARGET/stack" -p "$STACK_NAME" -f "$PKG_DIR/stack/docker-compose.yml" config -q
bash "$PKG_DIR/scripts/precheck.sh"
if [ "$DRY" -eq 1 ]; then printf '演练通过：身份、基线、校验和及编排有效；未运行健康检查或修改服务\n'; exit 0; fi
BASE_DIR="$TARGET"; STACK_DIR="$TARGET/stack"; LOG_DIR="$TARGET/logs"
lock_ops
[ "$(identity_value "$TARGET" BUILD_ID)" = "$BASELINE" ] || die '目标版本在等待运维锁期间变化，请重新选择基线'
snapshot 0
rollback_dir="$LAST_BACKUP"
rollback_on_failure() {
  rc=$?; trap - EXIT INT TERM
  if [ "$rc" -ne 0 ]; then
    audit "upgrade failed; rollback $rollback_dir" || printf '无法写入审计日志，继续恢复快照 %s\n' "$rollback_dir" >&2
    if ! restore_snapshot "$rollback_dir"; then printf '自动回滚失败，保留快照 %s；请人工恢复\n' "$rollback_dir" >&2; exit 2; fi
    if ! bash "$TARGET/scripts/ops.sh" status; then printf '回滚后健康检查失败\n' >&2; exit 2; fi
  fi
  exit "$rc"
}
trap rollback_on_failure EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
{% for img in images %}
docker load -i "$PKG_DIR/{{ img.file }}"
{% endfor %}
cp "$PKG_DIR/stack/docker-compose.yml" "$STACK_DIR/docker-compose.yml"
prepare_data
compose up -d --remove-orphans
health
# Publish scripts and identity only after successful candidate health checks.
cp "$PKG_DIR/scripts/ops.sh" "$PKG_DIR/scripts/runtime.sh" "$PKG_DIR/scripts/precheck.sh" "$PKG_DIR/scripts/apply-firewall.sh" "$TARGET/scripts/"
cp -R "$PKG_DIR/docs" "$TARGET/"
cp "$PKG_DIR/README.md" "$TARGET/"
if [ -f /etc/offline-preops/{{ firewall_chain }}.sh ]; then bash "$TARGET/scripts/apply-firewall.sh" --apply; fi
cp "$PKG_DIR/manifest.json" "$PKG_DIR/deployment.env" "$TARGET/"
printf '%s\n' "$EXPECTED_BUILD" > "$TARGET/.installed"
audit "upgrade complete $EXPECTED_BUILD rollback=$rollback_dir"
trap - EXIT INT TERM
printf '升级完成；回滚命令: bash %q/scripts/ops.sh rollback %q --yes\n' "$TARGET" "$rollback_dir"
