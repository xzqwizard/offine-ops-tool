#!/usr/bin/env bash
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo '需要 root'; exit 1; }
[ "${1:-}" = --apply ] || { echo '用法: apply-firewall.sh --apply；限制本机配置 IPv4 上 Docker 发布端口的来源'; exit 1; }
command -v iptables >/dev/null && command -v iptables-restore >/dev/null && iptables -nL DOCKER-USER >/dev/null || { echo '不支持的防火墙后端：需要 Docker IPv4 iptables DOCKER-USER（原生 nftables 不支持）'; exit 1; }
CHAIN={{ firewall_chain | shq }}
# Commit all chain changes together. A failed rule leaves the previous policy in place.
iptables-restore --noflush <<'RULES'
*filter
:{{ firewall_chain }} - [0:0]
-F {{ firewall_chain }}
-A {{ firewall_chain }} -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
{% for rule in allowed_rules %}
-A {{ firewall_chain }} -s {{ rule.from_ip }} -p {{ rule.protocol }} -m conntrack --ctorigdstport {{ rule.to_port }} -j RETURN
{% endfor %}
{% for p in local_ports %}
-A {{ firewall_chain }} -p {{ p.protocol }} -m conntrack --ctorigdstport {{ p.host }} -j DROP
{% endfor %}
-A {{ firewall_chain }} -j RETURN
COMMIT
RULES
iptables -C DOCKER-USER -m conntrack --ctorigdst {{ server.ip | shq }} -j "$CHAIN" 2>/dev/null || iptables -I DOCKER-USER 1 -m conntrack --ctorigdst {{ server.ip | shq }} -j "$CHAIN"
if [ "${2:-}" != --no-persist ]; then
  command -v systemctl >/dev/null || { echo '需要 systemd 持久化'; exit 1; }
  mkdir -p /etc/offline-preops
  cp "$0" "/etc/offline-preops/$CHAIN.sh"; chmod 700 "/etc/offline-preops/$CHAIN.sh"
  cat > "/etc/systemd/system/$CHAIN.service" <<UNIT
[Unit]
Description=OfflinePreOps Docker source whitelist
After=docker.service
Requires=docker.service
PartOf=docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /etc/offline-preops/$CHAIN.sh --apply --no-persist
[Install]
WantedBy=docker.service
UNIT
  systemctl daemon-reload
  systemctl enable "$CHAIN.service"
fi
printf '白名单已应用到 DOCKER-USER；未列出的外部来源将被拒绝。宿主本地访问不经过该链。\n'
