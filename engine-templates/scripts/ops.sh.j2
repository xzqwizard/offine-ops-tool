#!/usr/bin/env bash
# ============================================================
# 日常运维脚本 - 由离线部署运维工具生成（勿手改）
# 方案: {{ project_name }} | 服务器: {{ server.name }}
# 构建: {{ build_id }}
# 用法: bash ops.sh <子命令> [参数]   或无参数进入交互菜单
# ============================================================
set -euo pipefail

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
STACK_DIR="$BASE_DIR/stack"
COMPOSE_FILE="$STACK_DIR/docker-compose.yml"
BACKUP_DIR="{{ server.deploy_base_dir }}/backup"
SERVICES="{{ services_csv }}"

c() { docker compose -f "$COMPOSE_FILE" "$@"; }

usage() {
  cat <<EOF
用法: ops.sh <子命令> [参数]

  status            服务状态总览
  ps                docker compose ps
  start    <svc>    启动服务（all=全部）
  stop     <svc>    停止服务（all=全部）
  restart  <svc>    重启服务（all=全部）
  logs     <svc> [-f] [--tail N]   查看日志
  exec     <svc> [cmd...]          进入容器执行命令
  stats             资源占用（CPU/内存/网络）
  backup            备份数据卷到 backup/ 目录（tar 快照）
  cron-backup       配置每日 02:00 自动备份
  doctor            全面诊断（容器/端口/磁盘/日志错误关键字）
  config            显示编排关键信息（不含密码）
  version           本包信息
  help              本帮助

  svc 为服务名: ${SERVICES} 或 all
EOF
}

need_svc() {
  [ "${1:-}" = "all" ] && return 0
  echo "$SERVICES" | tr ',' '\n' | grep -qx "${1:-}" || { echo "未知服务: ${1:-}（可选: $SERVICES / all）"; exit 1; }
}

svc_all() { echo "$SERVICES" | tr ',' '\n'; }

cmd_status() {
  printf "%-22s %-12s %-10s %s\n" "SERVICE" "STATE" "HEALTH" "PORTS"
  for S in $(svc_all); do
    STATE=$(docker inspect -f "{{'{{'}}.State.Status{{'}}'}}" "$S" 2>/dev/null || echo "absent")
    HC=$(docker inspect -f "{{'{{'}}if .State.Health{{'}}'}}{{'{{'}}.State.Health.Status{{'}}'}}{{'{{'}}else{{'}}'}}-{{'{{'}}end{{'}}'}}" "$S" 2>/dev/null || echo "-")
    # docker port 在容器不存在时退出非零，必须兜底（set -e 会中止脚本）
    PORTS=$( { docker port "$S" 2>/dev/null || true; } | awk -F' -> ' '{printf "%s,", $2}' | sed 's/,$//')
    printf "%-22s %-12s %-10s %s\n" "$S" "$STATE" "$HC" "${PORTS:-}"
  done
}

cmd_cron_backup() {
  # 每日 02:00 自动备份（root 用 /etc/cron.d，普通用户用 crontab）
  CRON_LINE="0 2 * * * cd \"$BASE_DIR\" && bash scripts/ops.sh backup >> logs/cron-backup.log 2>&1"
  if [ "$(id -u)" -eq 0 ]; then
    {
      echo 'SHELL=/bin/bash'
      echo 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
      echo "$CRON_LINE"
    } > /etc/cron.d/offlinepreops-backup
    chmod 644 /etc/cron.d/offlinepreops-backup
    echo "已配置每日 02:00 自动备份（/etc/cron.d/offlinepreops-backup）"
  else
    (crontab -l 2>/dev/null | grep -v offlinepreops; echo "$CRON_LINE") | crontab -
    echo "已配置每日 02:00 自动备份（用户 crontab）"
  fi
  echo "  $CRON_LINE"
  echo "备份日志: $BASE_DIR/logs/cron-backup.log；自动保留最近 5 份"
}

cmd_doctor() {
  echo "===== doctor: $(date '+%F %T') ====="
  echo "--- 容器状态 ---"
  c ps -a || true
  echo "--- 端口监听 ---"
  PORTS="{{ exposed_ports_csv }}"
  for P in ${PORTS//,/ }; do
    if ss -lnt 2>/dev/null | awk '{print $4}' | grep -q ":${P}$"; then
      echo "  [✓] :$P 监听中"
    else
      echo "  [✗] :$P 未监听"
    fi
  done
  echo "--- 磁盘 ---"
  df -h | sed 's/^/  /'
  echo "--- 内存 ---"
  free -h | sed 's/^/  /'
  echo "--- 容器日志错误关键字（近200行）---"
  for S in $(svc_all); do
    CNT=$(docker logs --tail 200 "$S" 2>&1 | grep -ciE 'error|fatal|panic' || true)
    echo "  $S: ${CNT} 处 error/fatal/panic${CNT:+ （docker logs --tail 200 $S 查看）}"
  done
  echo "--- done ---"
}

cmd_backup() {
  TS=$(date '+%Y%m%d-%H%M%S')
  DEST="$BACKUP_DIR/$TS"
  mkdir -p "$DEST"
  echo "备份到: $DEST"
  for S in $(svc_all); do
    SRC="$BASE_DIR/stack/data/$S"
    if [ -d "$SRC" ]; then
      tar -czf "$DEST/${S}.tar.gz" -C "$(dirname "$SRC")" "$(basename "$SRC")"
      echo "  [✓] $S -> ${S}.tar.gz ($(du -h "$DEST/${S}.tar.gz" | cut -f1))"
    fi
  done
  # 数据库类中间件建议优先使用逻辑导出（mysqldump 等），此处为文件级快照兜底
  echo "提示: 数据库建议使用逻辑备份（见 docs/OPS-GUIDE.md 各中间件章节）"
  # 仅保留最近 5 份
  ls -1dt "$BACKUP_DIR"/*/ 2>/dev/null | tail -n +6 | xargs -r rm -rf
}

cmd_config() {
  echo "方案: {{ project_name }}  服务器: {{ server.name }} ({{ server.arch }})"
  echo "构建: {{ build_id }}"
  echo "服务: $SERVICES"
  echo "编排: $COMPOSE_FILE"
  echo "数据: $BASE_DIR/stack/data/<服务名>/"
  echo "端口明细见 docs/PORT-MATRIX.md"
}

case "${1:-menu}" in
  status)  cmd_status ;;
  ps)      c ps ;;
  start)   need_svc "${2:-}"; if [ "${2:-}" = "all" ]; then c start; else c start "${2}"; fi ;;
  stop)    need_svc "${2:-}"; if [ "${2:-}" = "all" ]; then c stop; else c stop "${2}"; fi ;;
  restart) need_svc "${2:-}"; if [ "${2:-}" = "all" ]; then c restart; else c restart "${2}"; fi ;;
  logs)    need_svc "${2:-}"; shift; c logs "$@" ;;
  exec)    need_svc "${2:-}"; S="$2"; shift 2; c exec "$S" "${@:-sh}" ;;
  stats)   docker stats --no-stream $(docker compose -f "$COMPOSE_FILE" ps -q) 2>/dev/null || docker stats --no-stream ;;
  backup)  cmd_backup ;;
  cron-backup) cmd_cron_backup ;;
  doctor)  cmd_doctor ;;
  config)  cmd_config ;;
  version) cmd_config ;;
  help|-h|--help) usage ;;
  menu)
    # ---------- 交互菜单 ----------
    while true; do
      echo
      echo "========= {{ server.name }} 运维菜单 ({{ project_name }}) ========="
      c ps --format 'table {{'{{'}}.Name{{'}}'}}\t{{'{{'}}.Status{{'}}'}}' 2>/dev/null | sed 's/^/  /'
      echo "------------------------------------------------------"
      echo "  1) 状态总览   2) 日志(选服务)   3) 重启(选服务)"
      echo "  4) 停止       5) 启动           6) 资源占用"
      echo "  7) 备份       8) 诊断 doctor"
      echo "  9) 定时备份    0) 退出"
      read -rp "请选择: " CHOICE
      case "$CHOICE" in
        1) cmd_status ;;
        2) read -rp "服务 ($SERVICES): " S; need_svc "$S"; read -rp "行数 [100]: " N; c logs --tail "${N:-100}" "$S" ;;
        3) read -rp "服务 ($SERVICES / all): " S; need_svc "$S"; [ "$S" = "all" ] && c restart || c restart "$S" ;;
        4) read -rp "服务 ($SERVICES / all): " S; need_svc "$S"; [ "$S" = "all" ] && c stop || c stop "$S" ;;
        5) read -rp "服务 ($SERVICES / all): " S; need_svc "$S"; [ "$S" = "all" ] && c start || c start "$S" ;;
        6) docker stats --no-stream ;;
        7) cmd_backup ;;
        8) cmd_doctor ;;
        9) cmd_cron_backup ;;
        0|*) exit 0 ;;
      esac
    done
    ;;
  *) usage; exit 1 ;;
esac
