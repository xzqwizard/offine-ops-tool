#!/usr/bin/env bash
set -euo pipefail
BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$BASE_DIR/scripts/runtime.sh"
root_required
check_identity "$BASE_DIR"
cmd=${1:-help}; shift || true
case "$cmd" in
  status) compose ps; health;;
  logs) if [ "${1:-}" = all ]; then shift; fi; compose logs --tail 200 "$@";;
  start|stop|restart) lock_ops; if [ "${1:-}" = all ]; then shift; fi; compose "$cmd" "$@"; audit "$cmd $*";;
  exec) [ "$#" -ge 2 ] || die '用法: ops.sh exec 服务 命令 [参数]'; lock_ops; audit "exec service=$1"; compose exec -T "$@";;
  backup) lock_ops; snapshot 1;;
  restore|rollback)
    [ "$#" -eq 2 ] && [ "$2" = --yes ] || die '用法: ops.sh restore|rollback 备份目录 --yes（覆盖数据，停止全部服务）'
    lock_ops; restore_snapshot "$1"; printf '%s\n' "$(identity_value "$BASE_DIR" BUILD_ID)" > "$BASE_DIR/.installed"
    # Restored scripts define the old health checks, not the upgraded checks in memory.
    bash "$BASE_DIR/scripts/ops.sh" status
    ;;
  prune-backups)
    retain=${1:-7}; [[ "$retain" =~ ^[1-9][0-9]*$ ]] || die '保留数量必须为正整数'; lock_ops
    mapfile -t complete < <(find "$BACKUP_DIR" -mindepth 2 -maxdepth 2 -name COMPLETE -printf '%h\n' | sort -r)
    {% raw %}for ((i=retain;i<${#complete[@]};i++)); do rm -rf -- "${complete[$i]}"; done{% endraw %}
    audit "prune backups retain=$retain";;
  report) REPORT="$LOG_DIR/report-$(date +%Y%m%d-%H%M%S)-$$.txt"; { date -Is; compose ps; df -h; free -m; docker version; } > "$REPORT"; printf '%s\n' "$REPORT";;
  help) printf '用法: ops.sh status|logs [服务]|start|stop|restart [服务]|exec 服务 命令|backup|restore|rollback 目录 --yes|prune-backups 保留数|report\n';;
  *) die "未知操作: $cmd";;
esac
