#!/usr/bin/env bash
set -euo pipefail
BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$BASE_DIR/scripts/runtime.sh"
root_required
[ "$(uname -m)" = {{ uname_arch | shq }} ] || die 'CPU 架构与交付包不匹配'
command -v timeout >/dev/null && command -v sha256sum >/dev/null && command -v tar >/dev/null && command -v ss >/dev/null || die '缺少 coreutils/tar/iproute2'
docker info >/dev/null
docker compose version >/dev/null
actual_docker=$(docker --version | awk '{print $3}' | tr -d ',')
[ "$actual_docker" = {{ server.docker_version | shq }} ] || die 'Docker 版本与交付包不一致，需重新全量构建'
available_mem=$(awk '/MemTotal:/ {print int($2/1024)}' /proc/meminfo)
[ "$available_mem" -ge {{ mem_need_gb * 1024 }} ] || die '内存不足'
parent=$(docker info --format {% raw %}'{{.DockerRootDir}}'{% endraw %})
[ "$parent" = {{ server.docker_data_root | shq }} ] || die '实际 Docker 数据目录与方案不一致，请调整方案后全量构建'
while [ ! -d "$parent" ]; do parent=$(dirname "$parent"); done
available=$(df -Pm "$parent" | awk 'END {print $4}')
[ "$available" -ge {{ disk_need_mb }} ] || die 'Docker 数据盘剩余空间不足'
{% for req in kernel_reqs %}
req={{ req | shq }}
key=${req%%>=*}; required=${req##*>=}
actual=$(sysctl -n "$key")
[ "$actual" -ge "$required" ] || die "内核参数 $req 未满足；请由管理员配置"
{% endfor %}
{% for p in local_ports %}
# TCP and UDP are separate. Only this project/server's containers may own a published port.
mapfile -t ids < <(docker ps --filter {{ ("publish=" ~ p.host ~ "/" ~ p.protocol) | shq }} --format {% raw %}'{{.ID}}'{% endraw %})
for id in "${ids[@]}"; do
  owner=$(docker inspect --format {% raw %}'{{index .Config.Labels "offlinepreops.project"}}/{{index .Config.Labels "offlinepreops.server"}}'{% endraw %} "$id")
  [ "$owner" = "$PROJECT_ID/$SERVER_ID" ] || die '端口 {{ p.host }}/{{ p.protocol }} 被其他容器占用'
done
if ss -Hln{% if p.protocol == 'udp' %}u{% else %}t{% endif %} | awk '$4 ~ /:{{ p.host }}$/ {found=1} END {exit !found}'; then
  [ {% raw %}"${#ids[@]}"{% endraw %} -gt 0 ] || die '端口 {{ p.host }}/{{ p.protocol }} 被宿主进程占用'
fi
{% endfor %}
printf '预检通过\n'
