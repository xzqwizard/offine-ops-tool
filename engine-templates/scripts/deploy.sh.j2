#!/usr/bin/env bash
# ============================================================
# 一键部署脚本 - 由离线部署运维工具生成（勿手改）
# 方案: {{ project_name }} | 服务器: {{ server.name }} ({{ server.arch }})
# 构建: {{ build_id }} | 生成时间: {{ generated_at }}
# 用法: bash deploy.sh [--dry-run] [--yes]
# 依赖: bash 4+ / tar / （可选）docker
# ============================================================
set -euo pipefail

DRY_RUN=0; ASSUME_YES=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --yes|-y)  ASSUME_YES=1 ;;
  esac
done

BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"   # 服务器包根目录
STACK_DIR="$BASE_DIR/stack"
IMAGES_DIR="$BASE_DIR/images"
DOCKER_OFFLINE_DIR="$BASE_DIR/docker-offline"
LOG_DIR="$BASE_DIR/logs"
COMPOSE_FILE="$STACK_DIR/docker-compose.yml"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/deploy-$(date '+%Y%m%d-%H%M%S').log"

step()  { echo -e "\n\033[1;36m==> $1\033[0m"; }
info()  { echo "    $1"; }
ok()    { echo -e "    \033[32m✓ $1\033[0m"; }
warn()  { echo -e "    \033[33m! $1\033[0m"; }
fail()  { echo -e "    \033[31m✗ $1\033[0m"; }

run() {
  if [ "$DRY_RUN" -eq 1 ]; then echo "    [dry-run] $*"; else "$@"; fi
}

exec > >(tee -a "$LOG_FILE") 2>&1

echo "============================================================"
echo " 离线部署 · {{ project_name }}"
echo " 服务器: {{ server.name }} ({{ server.arch }} / {{ server.os_family }} {{ server.os_version }})"
echo " 构建: {{ build_id }}"
echo " 日志: $LOG_FILE"
echo "============================================================"

if [ "$DRY_RUN" -eq 1 ]; then warn "dry-run 演练模式：不实际执行任何变更操作"; fi

# ---------- 1. 环境预检 ----------
step "1/6 环境预检"
if [ "$DRY_RUN" -eq 1 ]; then
  bash "$BASE_DIR/scripts/precheck.sh" || true
else
  if bash "$BASE_DIR/scripts/precheck.sh" --strict; then
    ok "预检通过"
  else
    fail "预检未通过，详见上方输出。强制部署请人工确认后重试。"
    exit 1
  fi
fi

# ---------- 2. Docker 引擎 ----------
step "2/6 Docker 引擎检查"
if command -v docker >/dev/null 2>&1; then
  ok "Docker 已安装: $(docker --version 2>/dev/null | head -1)"
else
  if [ -d "$DOCKER_OFFLINE_DIR/packages" ] && [ -n "$(ls -A "$DOCKER_OFFLINE_DIR/packages" 2>/dev/null)" ]; then
    info "从离线材料安装 Docker..."
    run bash "$DOCKER_OFFLINE_DIR/install-docker.sh"
  else
    fail "未安装 Docker，且包内无离线安装材料（docker-offline/packages 为空）"
    fail "请先在工具端配置 Docker 离线安装包后重新构建，或人工安装 Docker {{ server.docker_version }} 后重试"
    exit 1
  fi
fi
# dry-run 下目标机可能尚未安装 Docker/compose，版本检查只做提示不阻断
if [ "$DRY_RUN" -eq 1 ]; then
  docker compose version >/dev/null 2>&1 || info "[dry-run] 注意：本机暂未安装 docker compose（正式部署时将由离线材料安装）"
else
  if ! docker compose version >/dev/null 2>&1; then
    fail "缺少 docker compose v2 插件，请安装后重试（包内 docker-offline/ 含材料时 install-docker.sh 会一并安装）"
    exit 1
  fi
fi

# ---------- 3. 装载镜像 ----------
step "3/6 装载离线镜像"
{% if images | length == 0 %}
warn "本包未内嵌镜像 tar（M0 构建可不含镜像）：请确保目标镜像已存在于本机 docker images"
{% endif %}
{% for img in images %}
if [ -f "$BASE_DIR/{{ img.file }}" ]; then
  info "docker load: {{ img.file }}"
  run docker load -i "$BASE_DIR/{{ img.file }}"
else
  warn "缺少镜像文件 {{ img.file }}（{{ img.reference }}），该服务可能无法启动"
fi
{% endfor %}

# ---------- 4. 编排校验并启动 ----------
step "4/6 启动服务编排"
cd "$BASE_DIR"
run docker compose -f "$COMPOSE_FILE" config --quiet
# 非 root 镜像的数据目录预创建并授权（否则 compose 以 root 建目录后
# 容器内 uid 无写权限，启动即 Permission denied 崩溃循环）
{% for inst in instances %}
{% if inst.data_user %}
run mkdir -p "$STACK_DIR/data/{{ inst.instance_name }}"
run chown "{{ inst.data_user }}" "$STACK_DIR/data/{{ inst.instance_name }}"
{% endif %}
{% endfor %}
info "compose 配置校验通过，启动..."
run docker compose -f "$COMPOSE_FILE" up -d

# ---------- 5. 健康检查 ----------
step "5/6 健康检查"
HEALTH_FAIL=0
if [ "$DRY_RUN" -eq 1 ]; then
  info "[dry-run] 跳过健康检查"
else
{% for inst in instances %}
printf "    %-20s " "{{ inst.instance_name }}"
TRY=0; MAX={{ inst.health_timeout | default(60) }}; READY=0
while [ $TRY -lt $MAX ]; do
  STATE=$(docker inspect -f '{{'{{'}}.State.Running{{'}}'}}' "{{ inst.instance_name }}" 2>/dev/null || echo false)
  if [ "$STATE" = "true" ]; then
{% if inst.health_cmd %}
    if docker exec "{{ inst.instance_name }}" {{ inst.health_cmd }} >/dev/null 2>&1; then
      READY=1; break
    fi
{% elif inst.health_tcp %}
    if timeout 3 bash -c "</dev/tcp/127.0.0.1/{{ inst.health_tcp }}" 2>/dev/null; then
      READY=1; break
    fi
{% else %}
    READY=1; break
{% endif %}
  fi
  printf "."; TRY=$((TRY+3)); sleep 3
done
if [ $READY -eq 1 ]; then
  echo -e " \033[32m✓ 运行中/健康\033[0m"
else
  echo -e " \033[31m✗ 超时未就绪\033[0m"; HEALTH_FAIL=$((HEALTH_FAIL+1))
  docker logs --tail 50 "{{ inst.instance_name }}" 2>/dev/null | sed 's/^/        /' || true
fi
{% endfor %}
fi

# ---------- 6. 报告 ----------
step "6/6 部署报告"
{
  echo "===== 部署报告 {{ project_name }} / {{ server.name }} ====="
  echo "时间: $(date '+%F %T')"
  echo "构建: {{ build_id }}"
  echo
  docker compose -f "$COMPOSE_FILE" ps 2>/dev/null || true
} | tee "$LOG_DIR/deploy-report.txt"

echo
echo "------------------------------------------------------------"
if [ "$HEALTH_FAIL" -gt 0 ]; then
  warn "有 $HEALTH_FAIL 个服务未通过健康检查，请查上方日志与 $LOG_DIR/deploy-report.txt"
else
  ok "全部服务就绪。日常运维请使用: bash scripts/ops.sh （帮助: ops.sh help）"
  ok "运维文档: docs/OPS-GUIDE.md | 端口说明: docs/PORT-MATRIX.md"
fi
echo "------------------------------------------------------------"
[ "$HEALTH_FAIL" -eq 0 ] || exit 3
