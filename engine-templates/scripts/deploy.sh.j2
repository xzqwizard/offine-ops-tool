#!/usr/bin/env bash
set -euo pipefail
BASE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
source "$BASE_DIR/scripts/runtime.sh"
root_required
[ -z "$BASELINE_BUILD" ] || die '当前目录已完成增量升级，不能重跑旧全量部署脚本；请使用升级包或运维脚本'
verify_package
lock_ops
if [ -f "$BASE_DIR/.installed" ]; then
  check_identity "$BASE_DIR"
  [ "$(cat "$BASE_DIR/.installed")" = "$EXPECTED_BUILD" ] || die '目录已有其他版本，请使用 upgrade.sh'
fi
# Installer must run even when the engine exists, to install missing Compose.
bash "$BASE_DIR/scripts/precheck.sh" --before-install
bash "$BASE_DIR/docker-offline/install-docker.sh"
bash "$BASE_DIR/scripts/precheck.sh"
compose config -q
prepare_data
{% for img in images %}
docker load -i "$BASE_DIR/{{ img.file }}"
{% endfor %}
compose up -d --remove-orphans
if ! health; then audit 'deploy health failed'; compose logs --tail 100; die '健康检查失败，部署未标记成功'; fi
printf '%s\n' "$EXPECTED_BUILD" > "$BASE_DIR/.installed"
audit "deploy complete $EXPECTED_BUILD"
printf '部署完成。白名单需单独执行 bash scripts/apply-firewall.sh --apply\n'
