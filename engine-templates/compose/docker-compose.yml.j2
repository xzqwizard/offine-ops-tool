# ============================================================
# Docker Compose 编排 - 由离线部署运维工具生成（勿手改）
# 方案: {{ project_name }} | 服务器: {{ server.name }} ({{ server.arch }})
# 构建: {{ build_id }} | 生成时间: {{ generated_at }}
# 数据目录: ./data/<服务名>/ （相对本文件，位于 stack/ 下）
# ============================================================
name: {{ stack_name }}

services:
{% for inst in instances %}
{% set exposed = inst.ports | selectattr("expose") | list %}
  {{ inst.instance_name }}:
    image: "{{ inst.image }}"
    container_name: "{{ inst.instance_name }}"
    restart: unless-stopped
{% if exposed %}
    ports:
{% for p in exposed %}      - "{{ p.host }}:{{ p.container }}"
{% endfor %}{% endif %}
{% if inst.command %}
    command: [{% for c in inst.command %}'{{ c | replace("'", "''") }}'{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
{% if inst.data_user %}
    user: "{{ inst.data_user }}"
{% endif %}
{% if inst.depends %}
    depends_on:
{% for d in inst.depends %}      - "{{ d }}"
{% endfor %}{% endif %}
{% if inst.env %}
    environment:
{% for e in inst.env %}      {{ e.k }}: '{{ e.v }}'
{% endfor %}{% endif %}
    volumes:
      - ./data/{{ inst.instance_name }}:{{ inst.data_volume }}
{% endfor %}
