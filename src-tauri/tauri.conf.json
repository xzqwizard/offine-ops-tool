{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OfflinePreOpsTool",
  "version": "0.1.0",
  "identifier": "cn.weegoo.offlinepreops",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "离线部署运维工具",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
